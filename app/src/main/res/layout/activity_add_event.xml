<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fitsSystemWindows="true"
    android:paddingTop="28dp"
    android:paddingBottom="20dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add New Event"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/etEventName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Event Name"
            android:inputType="textCapSentences"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="16dp"
            android:textSize="15sp"
            android:textColor="#212529"
            android:textColorHint="#6B7280"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/etEventDate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Select Date (YYYY-MM-DD)"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:inputType="none"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="16dp"
            android:textSize="15sp"
            android:textColor="#212529"
            android:textColorHint="#6B7280"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/etEventLocation"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Location"
            android:inputType="textCapSentences"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="16dp"
            android:textSize="15sp"
            android:textColor="#212529"
            android:textColorHint="#6B7280"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/etEventOrganiser"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Organiser"
            android:inputType="textCapSentences"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="16dp"
            android:textSize="15sp"
            android:textColor="#212529"
            android:textColorHint="#6B7280"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Event Status"
            android:textColor="#555555"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerEventStatus"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input_field"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:spinnerMode="dropdown"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Event Type"
            android:textColor="#555555"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerEventType"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input_field"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:spinnerMode="dropdown"
            android:layout_marginBottom="24dp" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveEvent"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Save Event"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6200EE" />

    </LinearLayout>
</ScrollView>
